{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Universal Prompt Studio",
  "version": "0.2.0-alpha",
  "identifier": "com.universalpromptstudio.desktop",
  "build": {
    "beforeDevCommand": "npm run sidecar:build && npm run dev",
    "beforeBuildCommand": "npm run sidecar:build && npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Universal Prompt Studio",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/universal-prompt-studio-backend"],
    "resources": ["binaries/*.manifest.json"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "A local-first studio for reusable AI prompts.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
